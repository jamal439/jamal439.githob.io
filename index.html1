<!DOCTYPE html>
<html lang="fa" dir="rtl">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>جمال | سایت شخصی</title>

    <meta name="description"
          content="سایت شخصی جمال؛ پروژه‌ها، آموزش‌ها و مطالب کاربردی">

    <style>

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        html {
            scroll-behavior: smooth;
        }

        body {
            font-family: Tahoma, Arial, sans-serif;
            background: #070b1a;
            color: white;
            line-height: 1.8;
            overflow-x: hidden;
        }

        /* نورهای پس زمینه */

        body::before {
            content: "";
            position: fixed;
            width: 450px;
            height: 450px;
            background: #7c3aed;
            border-radius: 50%;
            filter: blur(150px);
            opacity: 0.35;
            top: -180px;
            right: -120px;
            z-index: -1;
            animation: move1 8s infinite alternate;
        }

        body::after {
            content: "";
            position: fixed;
            width: 400px;
            height: 400px;
            background: #2563eb;
            border-radius: 50%;
            filter: blur(150px);
            opacity: 0.3;
            bottom: -150px;
            left: -100px;
            z-index: -1;
            animation: move2 10s infinite alternate;
        }

        @keyframes move1 {
            from {
                transform: translate(0, 0);
            }

            to {
                transform: translate(-100px, 100px);
            }
        }

        @keyframes move2 {
            from {
                transform: translate(0, 0);
            }

            to {
                transform: translate(100px, -100px);
            }
        }

        /* هدر */

        header {
            position: sticky;
            top: 0;
            z-index: 999;

            background: rgba(7, 11, 26, 0.78);
            backdrop-filter: blur(15px);

            border-bottom: 1px solid rgba(255,255,255,0.08);
        }

        .navbar {
            max-width: 1100px;
            margin: auto;

            padding: 18px 20px;

            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .logo {
            font-size: 24px;
            font-weight: bold;

            background: linear-gradient(
                90deg,
                #60a5fa,
                #a78bfa,
                #f472b6
            );

            -webkit-background-clip: text;
            color: transparent;
        }

        nav {
            display: flex;
            gap: 22px;
        }

        nav a {
            color: #e5e7eb;
            text-decoration: none;
            transition: 0.3s;
        }

        nav a:hover {
            color: #60a5fa;
        }

        /* صفحه اصلی */

        .hero {
            min-height: 85vh;

            display: flex;
            align-items: center;
            justify-content: center;

            text-align: center;

            padding: 60px 20px;
        }

        .hero-content {
            max-width: 800px;

            animation: appear 1.2s ease;
        }

        @keyframes appear {
            from {
                opacity: 0;
                transform: translateY(40px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        .badge {
            display: inline-block;

            padding: 8px 18px;

            border-radius: 50px;

            background: rgba(96,165,250,0.1);

            border: 1px solid rgba(96,165,250,0.3);

            color: #93c5fd;

            margin-bottom: 25px;

            animation: floating 3s infinite ease-in-out;
        }

        @keyframes floating {
            0%, 100% {
                transform: translateY(0);
            }

            50% {
                transform: translateY(-8px);
            }
        }

        .hero h1 {
            font-size: 55px;
            line-height: 1.3;
            margin-bottom: 20px;
        }

        .hero h1 span {
            background: linear-gradient(
                90deg,
                #60a5fa,
                #a78bfa,
                #f472b6
            );

            -webkit-background-clip: text;
            color: transparent;

            background-size: 200%;

            animation: gradient 4s linear infinite;
        }

        @keyframes gradient {
            from {
                background-position: 0%;
            }

            to {
                background-position: 200%;
            }
        }

        .hero p {
            color: #aeb7c9;
            font-size: 19px;
            margin-bottom: 35px;
        }

        /* دکمه */

        .button {
            display: inline-block;

            padding: 14px 32px;

            color: white;

            text-decoration: none;

            border-radius: 12px;

            background: linear-gradient(
                90deg,
                #2563eb,
                #7c3aed
            );

            box-shadow:
                0 0 25px rgba(37,99,235,0.4);

            transition: 0.3s;
        }

        .button:hover {
            transform: translateY(-5px);

            box-shadow:
                0 0 40px rgba(124,58,237,0.6);
        }

        /* بخش ها */

        .section {
            max-width: 1100px;
            margin: auto;

            padding: 80px 20px;

            text-align: center;
        }

        .section h2 {
            font-size: 34px;
            margin-bottom: 15px;
        }

        .section-intro {
            color: #9ca3af;
            margin-bottom: 40px;
        }

        /* کارت ها */

        .cards {
            display: grid;

            grid-template-columns:
                repeat(3, 1fr);

            gap: 25px;
        }

        .card {
            padding: 35px 25px;

            background:
                rgba(255,255,255,0.06);

            border:
                1px solid rgba(255,255,255,0.1);

            border-radius: 20px;

            backdrop-filter: blur(15px);

            transition: 0.4s;
        }

        .card:hover {
            transform: translateY(-10px);

            border-color:
                rgba(96,165,250,0.5);

            box-shadow:
                0 15px 50px rgba(37,99,235,0.2);
        }

        .icon {
            font-size: 45px;
            margin-bottom: 15px;
        }

        .card h3 {
            margin-bottom: 10px;
        }

        .card p {
            color: #9ca3af;
        }

        /* فوتر */

        footer {
            padding: 30px 20px;

            text-align: center;

            color: #6b7280;

            border-top:
                1px solid rgba(255,255,255,0.08);
        }

        /* موبایل */

        @media (max-width: 700px) {

            .navbar {
                flex-direction: column;
                gap: 15px;
            }

            nav {
                gap: 15px;
                flex-wrap: wrap;
                justify-content: center;
            }

            .hero {
                min-height: 75vh;
            }

            .hero h1 {
                font-size: 38px;
            }

            .hero p {
                font-size: 17px;
            }

            .cards {
                grid-template-columns: 1fr;
            }

            .section {
                padding: 60px 20px;
            }

        }

    </style>

</head>

<body>

    <!-- منوی سایت -->

    <header>

        <div class="navbar">

            <div class="logo">
                جمال 🚀
            </div>

            <nav>

                <a href="index.html">
                    خانه
                </a>

                <a href="about.html">
                    درباره من
                </a>

                <a href="#services">
                    خدمات
                </a>

                <a href="contact.html">
    تماس
</a>
                    تماس
                </a>

            </nav>

        </div>

    </header>


    <!-- صفحه اصلی -->

    <section class="hero">

        <div class="hero-content">

            <div class="badge">
                ✨ خوش اومدی به سایت من
            </div>

            <h1>
                سلام، من <span>جمال</span> هستم 👋
            </h1>

            <p>
                اینجا قراره قدم‌به‌قدم یک سایت
                واقعی، جذاب و حرفه‌ای بسازیم.
            </p>

            <a
                href="#services"
                class="button"
            >
                شروع کنیم 🚀
            </a>

        </div>

    </section>


    <!-- خدمات -->

    <section
        class="<section class="section" id="projects">
    <h2>پروژه‌های من 💻🚀</h2>
    <p class="section-intro">
        اینجا پروژه‌هایی که در مسیر یادگیری و کار روی آن‌ها هستم نمایش داده می‌شوند.
    </p>

    <div class="cards">

        <div class="card">
            <div class="icon">🌐</div>
            <h3>سایت شخصی</h3>
            <p>
                اولین پروژه وب من با HTML و CSS که روی GitHub Pages منتشر شده است.
            </p>
            <span class="project-status">در حال توسعه 🚀</span>
        </div>

        <div class="card">
            <div class="icon">🔎</div>
            <h3>پروژه SEO</h3>
            <p>
                یک پروژه تمرینی برای یادگیری سئو و بهینه‌سازی سایت برای موتورهای جستجو.
            </p>
            <span class="project-status">به‌زودی ✨</span>
        </div>

        <div class="card">
            <div class="icon">⚡</div>
            <h3>پروژه آینده</h3>
            <p>
                یک پروژه بزرگ‌تر که در ادامه مسیر طراحی و برنامه‌نویسی ساخته خواهد شد.
            </p>
            <span class="project-status">Coming Soon 🔥</span>
        </div>

    </div>
</section>"
        id="services"
    >

        <h2>
            امکانات سایت ⚡
        </h2>

        <p class="section-intro">
            بخش‌های مختلفی که در ادامه توسعه می‌دهیم
        </p>


        <div class="cards">


            <div class="card">

                <div class="icon">
                    💻
                </div>

                <h3>
                    پروژه‌ها
                </h3>

                <p>
                    پروژه‌ها و کارهایی که در مسیر
                    ساخته می‌شوند.
                </p>

            </div>


            <div class="card">

                <div class="icon">
                    🌐
                </div>

                <h3>
                    طراحی سایت
                </h3>

                <p>
                    ساخت و توسعه صفحات مدرن
                    و جذاب اینترنتی.
                </p>

            </div>


            <div class="card">

                <div class="icon">
                    🔎
                </div>

                <h3>
                    SEO
                </h3>

                <p>
                    یادگیری و اجرای تکنیک‌های
                    بهینه‌سازی سایت.
                </p>

            </div>


        </div>

    </section>


    <!-- تماس -->

    <section
        class="section"
        id="contact"
    >

        <h2>
            تماس با من 📩
        </h2>

        <p class="section-intro">
            این قسمت رو در مرحله بعد کامل می‌کنیم.
        </p>

    </section>


    <!-- فوتر -->

    <footer>

        <p>
            © 2026 | ساخته شده با ❤️ و 🚀
        </p>

    </footer>

</body>

</html>